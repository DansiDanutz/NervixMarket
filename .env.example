# Database (required in production; without it listings go to .data/listings.json, local dev only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Featured spots: Nervix Space's own NervixPay payment link (10 USD, USDT/USDC) and its webhook secret
NERVIXPAY_LINK_ID=
NERVIXPAY_WEBHOOK_SECRET=
FEATURE_DAYS=30
# Public URL, used in manage links, the sitemap and metadata
SITE_URL=https://nervix.space
# Optional: email owners their manage link (Resend). Without it the link is shown once on screen.
RESEND_API_KEY=
MAIL_FROM=Nervix Space <hello@nervix.space>
# Moderation: admin API bearer token (16+ chars), reports that hide a listing, listings per IP per hour
ADMIN_TOKEN=
REPORTS_TO_HIDE=5
LISTINGS_PER_HOUR=5
# Salt for hashing IPs (any random string)
IP_SALT=
