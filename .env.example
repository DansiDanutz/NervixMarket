# Database (required in production; without it listings go to .data/listings.json, local dev only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Featured spots: Nervix Space's own NervixPay payment link (10 USD, USDT/USDC) and the webhook secret
NERVIXPAY_LINK_ID=
NERVIXPAY_WEBHOOK_SECRET=
FEATURE_DAYS=30
# Genesis 200: the first FREE_LISTING_CAP projects list free forever; after that a listing costs LISTING_USD once,
# paid on this NervixPay link (fixed price, USDT/USDC). Set it before the free spots run out (see /api/health).
FREE_LISTING_CAP=200
LISTING_USD=19
NERVIXPAY_LISTING_LINK_ID=
# Public URL, used in manage links, the sitemap and metadata
SITE_URL=https://nervix.space
# Optional: email owners their manage link (Resend). Without it the link is shown once on screen.
RESEND_API_KEY=
MAIL_FROM=Nervix Space <hello@nervix.space>
# Moderation: admin API bearer token (16+ chars), reports that hide a listing, listings per IP per hour
ADMIN_TOKEN=
# Daily Featured-expiry reminder job (Vercel Cron sends it as a bearer token; 16+ characters)
CRON_SECRET=
REPORTS_TO_HIDE=5
LISTINGS_PER_HOUR=5
# Salt for hashing IPs (any random string)
IP_SALT=
